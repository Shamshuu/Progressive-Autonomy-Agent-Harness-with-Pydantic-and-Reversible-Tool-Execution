# Database Connection URL (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@db:5432/agent_harness

# Progressive Autonomy Trust Threshold (N)
# Number of consecutive human-approved executions required before a tool action type graduates to autonomous execution.
# Default: 3
TRUST_THRESHOLD=3

# Application Port
# Port exposed by the FastAPI application service.
# Default: 8000
API_PORT=8000

# Mock LLM Toggle
# Set to 'true' to enable deterministic prompt parsing for reproducible automated testing and evaluations.
# Set to 'false' if connecting to an external model provider.
# Default: true
MOCK_LLM_ENABLED=true

# Application Metadata
PROJECT_NAME="Progressive Autonomy Agent Harness"
ENVIRONMENT=production

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_harness
